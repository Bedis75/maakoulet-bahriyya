# ---------------------------------------------------------------------------
# Copier ce fichier en « .env » puis remplir les valeurs.
# `npm run setup` le fait automatiquement s'il n'existe pas encore.
# ---------------------------------------------------------------------------

# Base de données.
# Développement (SQLite) :
DATABASE_URL="file:./dev.db"
# Production (Postgres — Neon / Supabase) : remplacer par l'URL fournie
# et changer `provider = "postgresql"` dans prisma/schema.prisma.
# DATABASE_URL="postgresql://user:motdepasse@host/base?sslmode=require"

# Clé de signature des sessions administrateur.
# En production, générer une valeur aléatoire : openssl rand -base64 32
AUTH_SECRET="changer-cette-valeur-en-production-32-caracteres-minimum"

# Adresse publique du site — SEULE source de vérité pour les URL canoniques,
# le sitemap, robots.txt, Open Graph et le JSON-LD. Aucun domaine en dur ailleurs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Compte administrateur créé par le seed (`npm run db:seed`).
ADMIN_EMAIL="admin@maakoulet-bahriyya.local"
ADMIN_PASSWORD="Admin1234!"
